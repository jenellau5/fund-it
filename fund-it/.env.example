# Neon Postgres connection string (from your Neon project dashboard)
DATABASE_URL=postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/fundit?sslmode=require

# Auth.js. Generate a secret with: npx auth secret
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Resend, used to send magic-link sign-in emails and deadline/match notifications
RESEND_API_KEY=
EMAIL_FROM="Fund It <hello@yourdomain.com>"

# Anthropic API key, used by the scheduled search job
ANTHROPIC_API_KEY=

# Shared secret so only Vercel Cron (or you) can trigger the search and notification routes
CRON_SECRET=
